# Optional. Without these the app runs in demo mode: hosts and participants
# can only see each other inside the same browser (BroadcastChannel).
#
# With them, rooms use Supabase Realtime broadcast, which works across devices.
# Broadcast messages are relayed, not stored. Create a free project at
# https://supabase.com, then copy Project URL and the anon public key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
